{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/board-published.mjs\"" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__(create_image_job|create_video_job|creative_generate_speech|creative_transcribe_audio|creative_design_voice|creative_generate_image|creative_generate_video|creative_edit_image|creative_generate_in_flow|creative_run_flow_nodes)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/studio-pre.mjs\"" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/studio-pre.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.+__(create_image_job|create_video_job|wait_for_job|get_job_result|get_asset|estimate_video_job|creative_generate_speech|creative_transcribe_audio|creative_design_voice|creative_get_flow_run_status|creative_show_flow_results)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/studio-post.mjs\"" }]
      },
      {
        "matcher": "^mcp__plugin_social-campaign_core__(pipeline_job_read|pipeline_job_create|pipeline_review_present|pipeline_decision_apply|pipeline_intake_update|pipeline_board_request_apply|pipeline_quote_save|pipeline_generation_land|pipeline_inputs_import|pipeline_product_photo_attach|pipeline_recipe_choose|pipeline_review_copies_prepare)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-bind.mjs\"" }]
      },
      {
        "matcher": "^(ArtifactData|Artifact|ArtifactComments)$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/board-published.mjs\"" }]
      },
      {
        "matcher": "^Artifact$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/artifact-assets.mjs\"" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pipeline-hook.mjs\"" }] },
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/board-stop.mjs\"" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pipeline-hook.mjs\"" }] }
    ]
  }
}
