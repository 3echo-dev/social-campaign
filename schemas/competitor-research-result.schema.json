{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-campaign.3echo.dev/schemas/competitor-research-result.schema.json",
  "title": "CompetitorResearchResult",
  "description": "Organic and paid creative strategies of relevant competitors, from the Competitor Researcher.",
  "type": "object",
  "required": ["schema_version", "scope", "competitors", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "brand_id": { "type": ["string", "null"] },
    "scope": { "enum": ["organic", "paid", "mixed"] },
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "observations"],
        "properties": {
          "name": { "type": "string" },
          "website": { "type": ["string", "null"] },
          "handles": { "type": "object", "additionalProperties": { "type": "string" } },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["claim", "confidence"],
              "properties": {
                "claim": { "type": "string" },
                "claim_kind": { "enum": ["fact", "observation", "inference", "hypothesis"] },
                "evidence_url": { "type": ["string", "null"] },
                "source_type": { "enum": ["official_source", "public_platform", "ad_library", "web_evidence", "user_supplied", "local_media", "model_inference"] },
                "source_ref": { "type": ["string", "null"] },
                "observed_at": { "type": ["string", "null"], "format": "date-time" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "creative_patterns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pattern": { "type": "string" },
                "platform": { "enum": ["facebook", "instagram", "tiktok"] },
                "frequency": { "enum": ["rare", "occasional", "common", "dominant"] },
                "example_url": { "type": ["string", "null"] }
              }
            }
          },
          "offers": { "type": "array", "items": { "type": "string" } },
          "cta_patterns": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Openings nobody in the set is taking. This is what feeds the Competitor Opportunity direction."
    },
    "coverage": {
      "enum": ["full", "partial", "thin", "none"],
      "description": "Downgraded when a research provider was unavailable, per the degraded mode rules."
    },
    "winning_patterns": { "type": "array", "description": "Patterns competitors keep investing in, from the creative-pattern-analysis method.", "items": { "type": "object", "required": ["pattern", "evidence", "confidence"], "properties": { "pattern": { "type": "string" }, "kind": { "enum": ["hook", "offer", "cta", "message", "format", "visual", "structure"] }, "competitors": { "type": "array", "items": { "type": "string" } }, "platforms": { "type": "array", "items": { "enum": ["facebook", "instagram", "tiktok"] } }, "investment_signal": { "enum": ["longevity", "variant_count", "repetition", "outlier_performance", "none", null] }, "evidence": { "type": "array", "items": { "type": "string" }, "description": "Observation ids." }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "opportunity_gaps": { "type": "array", "description": "Structured form of gaps, each tied to the evidence that shows nobody is taking it.", "items": { "type": "object", "required": ["gap", "evidence", "confidence"], "properties": { "gap": { "type": "string" }, "rationale": { "type": ["string", "null"] }, "evidence": { "type": "array", "items": { "type": "string" }, "description": "Observation ids." }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 } } } },
    "observations": {"type":"array","description":"What was seen or read, each with its own provenance. Nothing here is interpreted.","items":{"type":"object","required":["id","claim","source_type","source_ref","observed_at","confidence"],"properties":{"id":{"type":"string","description":"Short local id, for example O1, that inferences point at."},"claim":{"type":"string"},"source_type":{"enum":["official_source","public_platform","ad_library","web_evidence","user_supplied","local_media"]},"source_ref":{"type":"string","description":"The url, file path, asset id or tool call the claim came from."},"observed_at":{"type":"string","format":"date-time"},"confidence":{"type":"number","minimum":0,"maximum":1},"quote":{"type":["string","null"],"description":"Verbatim text when the claim is a quote."},"timestamp_s":{"type":["number","null"],"minimum":0,"description":"Where in a video, when it is from one."},"platform":{"enum":["facebook","instagram","tiktok","meta","web",null]}}}},
    "inferences": {"type":"array","description":"What the analyst concluded. Every inference names the observations it rests on.","items":{"type":"object","required":["id","claim","based_on","confidence"],"properties":{"id":{"type":"string","description":"Short local id, for example I1."},"claim":{"type":"string"},"based_on":{"type":"array","minItems":1,"items":{"type":"string"},"description":"Observation ids."},"source_type":{"const":"model_inference"},"reasoning":{"type":["string","null"]},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "source_refs": { "type": "array", "items": { "type": "string" }, "description": "AdLibraryResearchResult, SocialPostAnalysis and HookAnalysis artifacts this result draws on, as kind:version." },
    "degraded_reason": { "type": ["string", "null"], "description": "Why coverage is not full, in plain words. Null when it is." },
    "observed_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" }
  },
  "additionalProperties": false
}
