{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-campaign.3echo.dev/schemas/edit-decision-list.schema.json",
  "title": "EditDecisionList",
  "description": "An edit, as data, from the media-editing method: the source clips, the cuts in order with padding and word boundary snapping, audio, overlays, subtitles and the output format. video_build_edl checks and stores it, video_render_edl renders it, video_verify_render checks the result against it.",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "sources",
    "clips",
    "output",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "campaign_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Local id, S1, S2 and so on, that clips refer to."
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "transcript_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_id",
          "in_s",
          "out_s"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "in_s": {
            "type": "number",
            "minimum": 0
          },
          "out_s": {
            "type": "number",
            "minimum": 0
          },
          "pad_before_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "pad_after_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "snap_to_words": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "audio_fade_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "panel_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "audio": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "keep_source_audio": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "voiceover": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "asset_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "volume": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "music": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "asset_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "volume": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "duck": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "start_s",
          "end_s"
        ],
        "properties": {
          "kind": {
            "enum": [
              "text",
              "image"
            ]
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "position": {
            "enum": [
              "top",
              "middle",
              "lower_third",
              "bottom",
              null
            ]
          }
        }
      }
    },
    "subtitles": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "burn_in",
            "sidecar"
          ]
        },
        "source": {
          "enum": [
            "transcript",
            "script",
            null
          ]
        },
        "offset_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "aspect_ratio"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16",
            "1:1",
            "4:5",
            "16:9"
          ]
        },
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "fit": {
          "enum": [
            "pad",
            "crop",
            null
          ]
        }
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
