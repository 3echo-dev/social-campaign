{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-campaign.3echo.dev/schemas/copy-package.schema.json",
  "title": "CopyPackage",
  "description": "Platform appropriate copy written against an approved strategy direction, from the Copywriter.",
  "type": "object",
  "required": ["schema_version", "direction_key", "variants", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "campaign_id": { "type": ["string", "null"] },
    "direction_key": { "type": "string", "description": "Which approved StrategySet direction this executes." },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["platform", "caption", "cta"],
        "properties": {
          "platform": { "enum": ["facebook", "instagram", "tiktok"] },
          "headline": { "type": ["string", "null"], "description": "Ad jobs only." },
          "primary_text": { "type": ["string", "null"], "description": "Ad jobs only." },
          "description": { "type": ["string", "null"], "description": "Ad jobs only." },
          "caption": { "type": "string" },
          "hook_line": { "type": ["string", "null"], "description": "The first line, which has to survive the visible cutoff." },
          "cta": { "type": "string" },
          "hashtags": { "type": "array", "items": { "type": "string" } },
          "accessibility_text": { "type": ["string", "null"] },
          "disclosure": {
            "type": ["string", "null"],
            "description": "Paid partnership, gifted product or AI generated media, inside the caption text."
          },
          "character_count": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "provenance": {
      "type": "array",
      "description": "Every factual claim in the copy with the source that supports it.",
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": ["string", "null"] },
          "verified": { "type": ["boolean", "null"] }
        }
      }
    },
    "summary": { "type": "string" }
  },
  "additionalProperties": false
}
