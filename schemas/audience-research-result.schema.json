{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://social-campaign.3echo.dev/schemas/audience-research-result.schema.json",
  "title": "AudienceResearchResult",
  "description": "Audience problems, motivations, objections, language and content preferences, from the Audience Researcher.",
  "type": "object",
  "required": ["schema_version", "segments", "summary"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "brand_id": { "type": ["string", "null"] },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "problems"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "problems": { "type": "array", "items": { "type": "string" } },
          "motivations": { "type": "array", "items": { "type": "string" } },
          "objections": { "type": "array", "items": { "type": "string" } },
          "language": {
            "type": "array",
            "description": "Words the audience actually uses, quoted where possible.",
            "items": { "type": "string" }
          },
          "content_preferences": { "type": "array", "items": { "type": "string" } },
          "jobs_to_be_done": { "type": "array", "items": { "type": "string" } },
          "triggers": { "type": "array", "items": { "type": "string" }, "description": "What pushes them to look for a solution now." },
          "desired_outcomes": { "type": "array", "items": { "type": "string" } },
          "alternatives": { "type": "array", "items": { "type": "string" }, "description": "What they use or do instead today." },
          "evidence": { "type": "array", "items": { "type": "string" }, "description": "Observation ids." },
          "funnel_stage": {
            "enum": ["unaware", "problem_aware", "solution_aware", "product_aware", "most_aware"]
          },
          "evidence_urls": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "observations": {"type":"array","description":"What was seen or read, each with its own provenance. Nothing here is interpreted.","items":{"type":"object","required":["id","claim","source_type","source_ref","observed_at","confidence"],"properties":{"id":{"type":"string","description":"Short local id, for example O1, that inferences point at."},"claim":{"type":"string"},"source_type":{"enum":["official_source","public_platform","ad_library","web_evidence","user_supplied","local_media"]},"source_ref":{"type":"string","description":"The url, file path, asset id or tool call the claim came from."},"observed_at":{"type":"string","format":"date-time"},"confidence":{"type":"number","minimum":0,"maximum":1},"quote":{"type":["string","null"],"description":"Verbatim text when the claim is a quote."},"timestamp_s":{"type":["number","null"],"minimum":0,"description":"Where in a video, when it is from one."},"platform":{"enum":["facebook","instagram","tiktok","meta","web",null]}}}},
    "inferences": {"type":"array","description":"What the analyst concluded. Every inference names the observations it rests on.","items":{"type":"object","required":["id","claim","based_on","confidence"],"properties":{"id":{"type":"string","description":"Short local id, for example I1."},"claim":{"type":"string"},"based_on":{"type":"array","minItems":1,"items":{"type":"string"},"description":"Observation ids."},"source_type":{"const":"model_inference"},"reasoning":{"type":["string","null"]},"confidence":{"type":"number","minimum":0,"maximum":1}}}},
    "comment_mining_refs": { "type": "array", "items": { "type": "string" }, "description": "CommentMiningResult artifacts this result draws on, as kind:version." },
    "coverage": { "enum": ["full", "partial", "none"], "description": "How much of what was asked for could actually be read." },
    "degraded_reason": { "type": ["string", "null"], "description": "Why coverage is not full, in plain words. Null when it is." },
    "observed_at": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" }
  },
  "additionalProperties": false
}
