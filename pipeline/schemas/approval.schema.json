{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalDecision v1",
  "type": "object",
  "required": ["schemaVersion", "approvalId", "jobId", "brand", "gate", "round", "decision", "artifacts", "decidedBy", "decidedAt", "channel"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "approvalId": { "type": "string" },
    "jobId": { "type": "string" },
    "brand": { "type": "string" },
    "gate": { "enum": ["concept", "storyboard", "content", "publish", "campaign_proposal", "campaign_activation", "report", "findings"] },
    "round": { "type": "integer", "minimum": 1 },
    "decision": { "enum": ["approved", "changes_requested", "rejected"] },
    "edited": { "type": "boolean" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer" } } } },
    "decidedBy": { "type": "string", "minLength": 1 },
    "decidedAt": { "type": "string" },
    "channel": { "enum": ["chat", "file"] },
    "comment": { "type": "string" },
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "why": { "type": "string" },
    "gateAppDecisionId": { "type": "string" },
    "chosen": { "type": "string", "minLength": 1 },
    "scope": { "type": "object", "properties": { "publishPlanIncluded": { "type": "boolean" }, "maxSpendCredits": { "type": ["number", "null"], "minimum": 0 } } },
    "supersedes": { "type": ["string", "null"] }
  }
}
